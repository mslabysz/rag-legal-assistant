# The only required variable. The app will not start without it.
OPENAI_API_KEY=sk-your-openai-api-key

# Everything below has a default in src/rag_legal_assistant/config.py.
# Uncomment only what you actually want to override.

# Under docker compose, QDRANT_HOST is set to "qdrant" in docker-compose.yml.
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# COLLECTION_NAME=legal_docs

# Changing these requires re-indexing: scripts/reindex.py
# CHUNK_SIZE=512
# CHUNK_OVERLAP=50

# WARNING: EMBEDDING_PROVIDER=openai switches vectors from 768 to 1536 dimensions.
# An existing Qdrant collection will reject them - drop it and re-index the corpus.
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=sdadas/st-polish-paraphrase-from-mpnet

# LLM_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=60.0
# OPENAI_MAX_RETRIES=2

# RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2
# RERANKER_CACHE_DIR=model_cache/flashrank

# MAX_UPLOAD_MB=25

# How many times the agent may rewrite the query before it answers with what it has.
# MAX_QUERY_REWRITES=3